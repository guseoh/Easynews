# Actual values belong only in server/.env (ignored by Git).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Easynews extension ID shown in chrome://extensions (32 lowercase a-p characters).
EASYNEWS_EXTENSION_ID=
AI_PROVIDER=chatgpt-plan
# Plan: gpt-6-luna. Explanation=xhigh; related search/classification=medium.
# Hosted web search needs no separate OpenAI or NAVER API key.
# Select the existing API key provider explicitly if needed:
# AI_PROVIDER=api-key
